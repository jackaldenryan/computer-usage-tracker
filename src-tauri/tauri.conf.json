{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Work Hours Tracker",
  "version": "0.1.0",
  "identifier": "com.workhours.tracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && bash scripts/bundle-helper.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Work Hours Tracker",
        "width": 1080,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png"],
    "resources": {
      "resources/bin/wht-track": "bin/wht-track"
    },
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
