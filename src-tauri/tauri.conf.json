{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Work Hours Tracker",
  "version": "0.1.2",
  "identifier": "com.workhours.tracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && bash scripts/bundle-helper.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Work Hours Tracker",
        "width": 1080,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/bin/wht-track": "bin/wht-track"
    },
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4MTBGRUY3RkUyQzcwMTgKUldRWWNDeis5LzRRdU5lR2oxdUFxanMvbjlvNkxmVUFGKzRnM0I1VmVhRnVvWFo0SjFPb05kKy8K",
      "endpoints": [
        "https://github.com/jackaldenryan/work-hours-tracker/releases/latest/download/latest.json"
      ]
    }
  }
}
